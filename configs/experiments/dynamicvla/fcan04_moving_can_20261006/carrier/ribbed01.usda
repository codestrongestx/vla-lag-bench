#usda 1.0
(
    defaultPrim = "Carrier"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Carrier" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:rigidBodyEnabled = 1
    bool physics:kinematicEnabled = 0
    def Cube "rail_0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1
        token visibility = "invisible"
        rel material:binding:physics = </Carrier/PhysicsMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double3 xformOp:translate = (0, -0.140000, 0.007000)
        float3 xformOp:scale = (0.270000, 0.004000, 0.014000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
